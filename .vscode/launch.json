{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Backend",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "backend.app.main:app",
                "--reload",
                "--port",
                "8000"
            ],
            "jinja": true,
            "justMyCode": true,
            "cwd": "${workspaceFolder}",
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "console": "integratedTerminal"
        },
        {
            "name": "NGROK",
            "type": "node-terminal",
            "request": "launch",
            "command": "ngrok http 8000"
        },
        {
            "name": "React Frontend",
            "type": "node-terminal",
            "request": "launch",
            "command": "npm run dev",
            "cwd": "${workspaceFolder}/frontend"
        }
    ],
    "compounds": [
        {
            "name": "DataPilot",
            "configurations": [
                "Python Backend",
                "NGROK",
                "React Frontend"
            ]
        }
    ]
}