# Environment variables for the backend application

# Database configuration
DATABASE_URL=your_database_url_here

# JWT configuration
JWT_SECRET_KEY=your_jwt_secret_key
JWT_ALGORITHM=your_jwt_algorithm
ACCESS_TOKEN_EXPIRE_MINUTES=your_access_token_expiration_time_in_minutes
REFRESH_TOKEN_EXPIRE_DAYS=your_refresh_token_expiration_time_in_days

# CORS configuration
CORS_ORIGINS=your_frontend_origins_here

# AWS Configuration
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key
AWS_REGION=your_aws_region

# AWS S3 Bucket Configuration
S3_BUCKET_NAME=your_bucket_name